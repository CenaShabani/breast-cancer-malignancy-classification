# Data — regenerated by src/acquisition.py, never committed.
# CC BY 4.0 would permit redistribution, but downloading at runtime keeps the
# provenance record and the file guaranteed consistent.
data/

# Outputs — regenerated by run_analysis.py, so ignored by default.
# Figures are the exception: the README embeds them, so they must be committed
# or the project page renders with broken images.
outputs/*
!outputs/figures/
outputs/figures/*
!outputs/figures/*.png

# Secrets
.env
*.pem
kaggle.json
**/secrets/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
